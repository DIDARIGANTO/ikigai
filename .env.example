# Облако Supabase. Если обе переменные пустые — приложение хранит данные в браузере.
# Где взять: Supabase → Project Settings → API (подробно в docs/SETUP.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Имя Telegram-бота без «@» (например ikigai_dm_bot) — из него собирается ссылка привязки.
# Нужно только для кнопки «Подключить Telegram» в настройках (подробно в docs/SETUP.md).
VITE_TELEGRAM_BOT=
